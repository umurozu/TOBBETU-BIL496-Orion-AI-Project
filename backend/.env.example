# =============================================================
#  Invisio Backend — Environment Variables
#  Copy this file to .env and customize for your environment.
# =============================================================

# --- Application ---
APP_NAME=Invisio
APP_VERSION=1.0.0
DEBUG=True

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database (PostgreSQL in Docker) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/invisio
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Authentication (JWT) ---
# IMPORTANT: Generate a secure key for production!
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Processing ---
DEVICE=cuda

# Optional: override python executable used for LaMa subprocess (object removal / inpainting)
# Example (Windows): LAMA_PYTHON_BIN=C:\\Users\\you\\Desktop\\project\\models\\u2net-demo\\.venv\\Scripts\\python.exe
LAMA_PYTHON_BIN=
# Optional: base directory for model repos (contains `u2net-demo/`, `lama/`, etc.)
MODELS_BASE_DIR=
REMOTE_INFERENCE_URL=
REMOTE_INFERENCE_API_KEY=
REMOTE_INFERENCE_SAM_TIMEOUT_SECONDS=60
REMOTE_INFERENCE_HAIRFASTGAN_TIMEOUT_SECONDS=300
HAIRSTYLE_MODEL_ID=runwayml/stable-diffusion-inpainting
HAIRSTYLE_MODEL_PATH=checkpoints/hairstyle/model/runwayml-stable-diffusion-inpainting
HAIRSTYLE_CACHE_DIR=checkpoints/hairstyle/cache
HAIRSTYLE_DEVICE=cuda
HAIRSTYLE_STEPS=20
HAIRSTYLE_GUIDANCE_SCALE=7.5
HAIRSTYLE_STRENGTH=0.92
HAIRSTYLE_MAX_EDGE=512
HAIR_TRANSFER_MAX_EDGE=1024
HAIR_TRANSFER_BLEND_STRENGTH=0.84
HAIR_TRANSFER_COLOR_STRENGTH=0.78
HAIR_TRANSFER_SHARPEN_AMOUNT=0.9
AGING_SAM_VENDOR_DIR=vendor/SAM
AGING_SAM_CHECKPOINT_PATH=checkpoints/aging/sam_ffhq_aging.pt
AGING_SAM_DEVICE=cuda
COLORIZATION_VENDOR_DIR=vendor/invisio_colorizers
COLORIZATION_CLUSTER_POINTS_PATH=checkpoints/colorization/cluster_points.npy
COLORIZATION_WEIGHTS_PATH=checkpoints/colorization/colorization_release_v2-9b330a0b.pth
COLORIZATION_DEVICE=cuda
COLORIZATION_INPUT_SIZE=256

# --- Logging ---
LOG_LEVEL=INFO
